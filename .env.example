# FlowDesk AI Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Neon PostgreSQL (required for database)
# Use the pooled connection string for the app
DATABASE_URL=your_neon_pooled_connection_string
# Use the direct (non-pooled) connection string for migrations
DATABASE_URL_UNPOOLED=your_neon_direct_connection_string

# Better Auth (required for authentication)
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here_at_least_32_chars

# Gemini AI (required for AI assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash